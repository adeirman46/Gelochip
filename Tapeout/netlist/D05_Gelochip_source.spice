.subckt LOAD_DIODE VOUT VSS
X0 VOUT VSS VSS NDIODE_1
.ends LOAD_DIODE

.subckt RFEH_CORE RFP RFN VRECT VOUT VSS VMID1 VMID2 N1 N2
X0 RFP RFN VRECT VSS RECTIFIER
X1 VRECT VMID1 VMID2 VSS STARTUP_BIAS
X2 VRECT N1 N2 VOUT VSS PUMP_LADDER
X3 VOUT VSS LOAD_DIODE
.ends RFEH_CORE

.subckt D05_GELOCHIP VSS RFP RFN VOUT VCC VMID1 VMID2 N1 N2
