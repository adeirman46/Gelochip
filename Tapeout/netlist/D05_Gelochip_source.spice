XDUMMY VB VB VB VB nfet_03v3 l=0.28 w=3.0 m=2
.ends two_trans_interdigitized_1

.subckt RECTIFIER RFP RFN VRECT VSS
X0 VRECT VRECT RFP RFN RFN RFP VRECT two_trans_interdigitized l=0.28 w=5.0 m={1}
X1 VSS VSS RFP RFN RFN RFP VSS two_trans_interdigitized_1 l=0.28 w=3.0 m={1}
.ends RECTIFIER

.subckt two_trans_interdigitized_2 VDD1 VDD2 VSS1 VSS2 VG1 VG2 VB l=1.0 w=4.0 m=1 
XA VDD1 VG1 VSS1 VB pfet_03v3 l=1.0 w=4.0 m=2
XB VDD2 VG2 VSS2 VB pfet_03v3 l=1.0 w=4.0 m=2
XDUMMY VB VB VB VB pfet_03v3 l=1.0 w=4.0 m=2
.ends two_trans_interdigitized_2

.subckt two_trans_interdigitized_3 VDD1 VDD2 VSS1 VSS2 VG1 VG2 VB l=1.0 w=2.0 m=1 
XA VDD1 VG1 VSS1 VB nfet_03v3 l=1.0 w=2.0 m=2
XB VDD2 VG2 VSS2 VB nfet_03v3 l=1.0 w=2.0 m=2
XDUMMY VB VB VB VB nfet_03v3 l=1.0 w=2.0 m=2
.ends two_trans_interdigitized_3

.subckt STARTUP_BIAS VRECT VMID1 VMID2 VSS
X0 VMID1 VMID2 VRECT VRECT VMID1 VMID2 VRECT two_trans_interdigitized_2 l=1.0 w=4.0 m={1}
X1 VMID1 VMID2 VSS VSS VMID1 VMID2 VSS two_trans_interdigitized_3 l=1.0 w=2.0 m={1}
.ends STARTUP_BIAS

.subckt NMOS D G S B DUM l=0.28 w=4.0
XMAIN1 D G S B nfet_03v3 l=0.28 w=4.0
XMAIN2 D G S B nfet_03v3 l=0.28 w=4.0
XDUMMY1 DUM DUM DUM B nfet_03v3 l=0.28 w=4.0
XDUMMY2 DUM DUM DUM B nfet_03v3 l=0.28 w=4.0
.ends NMOS

.subckt NDIODE P N B
X0 P P N B B NMOS l=0.28 w=4.0
.ends NDIODE

.subckt PUMP_LADDER VRECT N1 N2 VOUT VSS
X0 VRECT N1 VSS NDIODE
X1 N1 N2 VSS NDIODE
X2 N2 VOUT VSS NDIODE
.ends PUMP_LADDER

.subckt NMOS_1 D G S B DUM l=10.0 w=1.0
