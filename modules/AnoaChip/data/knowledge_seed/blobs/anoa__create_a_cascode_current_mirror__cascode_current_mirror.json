  "nets": {
    "VDD": "positive supply rail (3.3 V); external current source reference, not connected to NMOS drains",
    "VSS": "ground rail (0 V); common source/body of all six NMOS devices",
    "I_in": "top-level input current node (drain of M3); tied to I_ref_bias",
    "I_out": "top-level output current node (drain of M4); drives the 1 pF load",
    "I_in_cas": "internal node: source of M3 = drain of M1 (diode)",
    "I_out_cas": "internal node: source of M4 = drain of M2 (mirror)",
    "I_ref_bias": "bias branch input node (drain/gate of M5, source of M6); tied to I_in",
    "V_bias_mirror": "gate bias net driven by diode-connected M1; gates of M1 and M2",
    "V_bias_cascode": "cascode gate bias net (~1.1 V) generated by M5/M6; gates of M3, M4, M6"
  },
  "connections": [
    "I_in tied to I_ref_bias (same reference current feeds mirror input and bias branch)",
    "M1 gate tied to M1 drain (diode-connected) forming V_bias_mirror",
    "M5 gate tied to M5 drain (diode-connected) at I_ref_bias",
    "M6 gate tied to M6 drain (diode-connected) forming V_bias_cascode",
    "M1, M2, M5 sources and bodies tied to VSS",
    "M3, M4 bodies tied to VSS"
  ],
  "blocks": {
