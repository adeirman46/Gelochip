{
  "name": "cascode_current_mirror",
  "pdk": "gf180mcuD",
  "description": "Single-output NMOS cascode current mirror with self-biased cascode gate. Stacks a common-gate NMOS (M3/M4) above the diode/mirror pair (M1/M2); a bias branch (M5/M6) self-biases the cascode gate from the same I_ref. Targets 10 uA 1:1 mirror with >=10 MOhm output resistance and >=1.0 V compliance on a 3.3 V supply.",
  "ports": [
    "VDD",
    "VSS",
    "I_in",
    "I_out"
  ],
  "spec": {
    "topology": "cascode_current_mirror",
    "device_class": "NMOS sink, single output",
    "supply_v": 3.3,
    "input_current_a": 1e-05,
    "output_current_a": 1e-05,
    "mirror_ratio": 1,
    "output_resistance_ohm": 10000000.0,
    "compliance_v": 1.0,
    "dc_gain_db": 140,
    "bandwidth_hz": 1000000.0,
    "unity_gain_bandwidth_hz": 10000000.0,
    "phase_margin_deg": 60,
    "power_w": 3.3e-05,
    "load_f": 1e-12,
    "current_mismatch_pct": 1,
    "settling_time_s": 1e-06
  },
  "params": {
    "VDD": 3.3,
    "VSS": 0,
    "I_ref": 1e-05,
    "V_bias_cascode_v": 1.1,
    "C_L": 1e-12,
    "M1": {
      "w": 5e-06,
      "l": 1e-06,
      "fingers": 1,
      "m": 1,
      "model": "gf180mcu_fd_pr__nfet_03v3"
    },
    "M2": {
      "w": 5e-06,
      "l": 1e-06,
      "fingers": 1,
      "m": 1,
      "model": "gf180mcu_fd_pr__nfet_03v3"
    },
    "M3": {
      "w": 5e-06,
      "l": 1e-06,
      "fingers": 1,
      "m": 1,
      "model": "gf180mcu_fd_pr__nfet_03v3"
    },
    "M4": {
      "w": 5e-06,
      "l": 1e-06,
      "fingers": 1,
      "m": 1,
      "model": "gf180mcu_fd_pr__nfet_03v3"
    },
    "M5": {
      "w": 5e-06,
      "l": 1e-06,
      "fingers": 1,
      "m": 1,
      "model": "gf180mcu_fd_pr__nfet_03v3"
    },
    "M6": {
      "w": 5e-06,
      "l": 1e-06,
      "fingers": 1,
      "m": 1,
      "model": "gf180mcu_fd_pr__nfet_03v3"
    }
  },
  "wiring": [
    {
