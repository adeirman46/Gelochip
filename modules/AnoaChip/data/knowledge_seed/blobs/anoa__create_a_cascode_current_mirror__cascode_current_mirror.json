        "M5",
        "M6"
      ],
      "ports": [
        "VSS",
        "I_ref_bias",
        "V_bias_cascode"
      ]
    }
  },
  "layout": {
    "pdk": "gf180mcuD",
    "placement": {
      "M1": {
        "center": [
          0,
          0
        ],
        "role": "input mirror diode"
      },
      "M2": {
        "center": [
          1e-05,
          0
        ],
        "role": "output mirror"
      },
      "M3": {
        "center": [
          0,
          5e-06
        ],
        "role": "input cascode (above M1)"
      },
      "M4": {
        "center": [
          1e-05,
          5e-06
        ],
        "role": "output cascode (above M2)"
      },
      "M5": {
        "center": [
          0,
          -1e-05
        ],
        "role": "bias diode (below M1)"
      },
      "M6": {
        "center": [
          0,
          -5e-06
        ],
        "role": "bias cascode diode (above M5)"
      }
    },
    "routes": {
      "VSS": "straight_route along bottom, common rail to M1/M2/M5 sources",
      "V_bias_mirror": "c_route from M1 drain/gate to M2 gate",
      "V_bias_cascode": "c_route from M6 drain/gate to M3 gate and M4 gate, via_stack to cross over",
      "I_in_cas": "straight_route from M3 source to M1 drain",
      "I_out_cas": "straight_route from M4 source to M2 drain",
      "I_in": "c_route from M3 drain to left I_in pad; ties to I_ref_bias",
      "I_out": "c_route from M4 drain to right I_out pad",
      "I_ref_bias": "c_route from M5 drain/gate to M6 source and to I_in"
    },
    "finishing": {
