# PandaChip environment — copy to .env and fill in (run.sh sources it).
# Google Gemini via Vertex AI, authenticated with Application Default
# Credentials (gcloud auth application-default login).
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=~/.config/gcloud/application_default_credentials.json
# PANDACHIP_GEMINI_MODELS=gemini-3.1-pro-preview,gemini-3.5-flash,gemini-2.5-pro
# PANDACHIP_GEMINI_MAX_TOKENS=16384
# Web research tools for the agent (search_web / fetch_reference)
PANDACHIP_WEB_RESEARCH=1
# SEARXNG_URL=http://localhost:8888
# GITHUB_TOKEN=
# PANDACHIP_RESEARCH_MODEL=gemini-3.5-flash
